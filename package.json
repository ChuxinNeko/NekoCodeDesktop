{
  "name": "nekocode-desktop",
  "version": "0.0.4",
  "private": true,
  "description": "NekoCode Desktop - Electron desktop coding agent built on the PI agent core",
  "author": "ChuxinNeko",
  "homepage": "https://github.com/ChuxinNeko/NekoCodeDesktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChuxinNeko/NekoCodeDesktop.git"
  },
  "main": "out/main/index.js",
  "workspaces": [
    "pi/packages/*",
    "pi/packages/session-backends/*"
  ],
  "scripts": {
    "dev": "bunx --bun --no-install electron-vite dev",
    "build": "bunx --bun --no-install electron-vite build",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never",
    "start": "bunx --bun --no-install electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pi:build": "bun scripts/pi-toolchain.ts build",
    "pi:setup": "bun install && bun scripts/pi-toolchain.ts build",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:build": "vite build --config mobile/vite.config.ts",
    "mobile:sync": "bun run mobile:build && cap sync android",
    "test": "bun test src scripts mobile/src",
    "test:lan": "bun test src/main/task-manager.test.ts src/main/lan-service.test.ts mobile/src/lan-client.test.ts src/shared/lan-pairing.test.ts",
    "test:lan:integration": "bun scripts/test-lan-integration.ts",
    "mobile:apk": "bun scripts/build-android.ts",
    "mobile:sync:ios": "bun run mobile:build && cap sync ios",
    "mobile:ipa": "bun scripts/build-ios.ts"
  },
  "trustedDependencies": [
    "@google/genai",
    "electron",
    "esbuild",
    "node-pty",
    "protobufjs"
  ],
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8",
    "@capacitor/barcode-scanner": "3.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8",
    "@earendil-works/pi-agent-core": "workspace:0.85.1",
    "@earendil-works/pi-ai": "workspace:0.85.1",
    "@earendil-works/pi-coding-agent": "workspace:0.85.1",
    "@tabler/icons-react": "^3.44.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "border-beam": "^1.3.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "node-pty": "1.1.0",
    "qrcode.react": "4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.3.1",
    "typebox": "1.3.27",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.10.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "1.4.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.2",
    "shx": "0.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
