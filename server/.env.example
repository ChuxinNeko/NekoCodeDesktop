# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# What nginx proxies to. The public GitHub callback URL is configured below.
PORT=3000
# Loopback so the app cannot be reached except through the reverse proxy.
# The IP rate limiter trusts x-forwarded-for, which is only true behind one.
BIND_HOST=127.0.0.1

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nekocode

# Signs access tokens and HMACs verification codes at rest.
# Generate with: openssl rand -base64 48
# Changing it signs everyone out and invalidates outstanding codes.
JWT_SECRET=

# Seconds. Access tokens stay short because they cannot be revoked.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# BillionMail. 465 is implicit TLS; 587 upgrades with STARTTLS.
SMTP_HOST=mail.nekofun.top
SMTP_PORT=465
SMTP_USER=noreply@nekofun.top
SMTP_PASS=
SMTP_FROM=NekoCode <noreply@nekofun.top>

# Only if the mail server presents a certificate the system cannot verify.
# The connection stays encrypted but stops being authenticated — prefer fixing
# the certificate.
SMTP_ALLOW_SELF_SIGNED=false

# Optional public GitHub App. Leave all five empty to disable OAuth endpoints.
# Register for "Any account" and enable Device Flow.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Must exactly match the GitHub App's user authorization callback URL.
# GITHUB_APP_CALLBACK_URL=https://codeapi.nekofun.top/github/auth/callback
GITHUB_APP_CALLBACK_URL=
# The slug from https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# Separate AES-GCM key for short-lived authorization handoff records in MongoDB.
# Generate with: openssl rand -base64 48
GITHUB_AUTH_ENCRYPTION_KEY=
