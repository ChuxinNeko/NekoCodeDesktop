{
	"name": "@earendil-works/pi-protocol",
	"version": "0.87.1",
	"description": "Transport-neutral CBOR protocol for remote pi sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"keywords": [
		"pi",
		"protocol",
		"cbor",
		"binary",
		"framing"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/chord": "^0.87.1",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
